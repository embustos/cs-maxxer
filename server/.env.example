# Copy to .env and fill in. .env is gitignored — never commit it.
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Matches docker-compose.yml
DATABASE_URL=postgres://cstracker:devpassword@localhost:5433/cs_tracker
REDIS_URL=redis://localhost:6379

# Comma-separated. In production you usually need two: the host's own URL and your
# real domain. In dev any localhost port is accepted regardless of this value.
CLIENT_ORIGIN=http://localhost:5173
# Where the app lives from the outside. Used to build the links inside emails, and NOT
# derived from the request — a reset link built from a Host header is a reset link an
# attacker can aim at their own server.
APP_URL=http://localhost:5173
PORT=3000

# Optional. Without it GitHub allows 60 requests/hour per IP; with it, 5000/hour.
# github.com -> Settings -> Developer settings -> Personal access tokens
# -> Fine-grained tokens. Needs NO scopes for public data.
GITHUB_TOKEN=

# Optional, for the AI message and resume review. console.anthropic.com -> API keys.
# This is NOT your Claude Code subscription — it bills per call (~$0.02 a review).
# Without it the review endpoints return 503 and the UI explains how to turn them on.
ANTHROPIC_API_KEY=

# Optional, for the daily digest and password-reset email. resend.com, free tier.
# The free tier only delivers to your OWN verified address until you verify a domain.
RESEND_API_KEY=
# Must be an address at a domain you've verified in Resend. Leave unset to use their
# sandbox sender, which only reaches you.
MAIL_FROM=cs maxxer <onboarding@resend.dev>

# Monthly cap on paid AI reviews, per user. Signups are open, so this is what stands
# between one enthusiastic user and your Anthropic bill. Defaults to 40.
AI_MONTHLY_CAP=40
