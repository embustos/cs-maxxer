# Overrides the Caddyfile Railpack generates for a static site. Mirrors that default —
# same security headers, same SPA fallback — and adds the one thing it lacks: cache
# control. Without it Railway serves index.html with an ETag and no Cache-Control, so
# browsers cache it heuristically and keep loading the PREVIOUS build's bundle. Every
# deploy then looks like it silently did nothing to anyone who has visited before.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# Vite content-hashes these filenames, so the name changes whenever the bytes do.
	# That makes them safe to cache forever, and it is what lets index.html revalidate
	# on every load without costing a real download.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is index.html — directly, or through the SPA fallback below.
	# "no-cache" means "revalidate before use", NOT "don't store": the ETag Caddy
	# already sends turns an unchanged page into a 304 with no body.
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	# ponytail: path defaults to Railpack's build output. If the deploy 404s, point
	# STATIC_ROOT at the right directory in Railway's variables instead of redeploying.
	root * {$STATIC_ROOT:/app/dist}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
